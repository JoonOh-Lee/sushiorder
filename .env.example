# docker-compose 로컬 실행용 환경변수 템플릿.
# 실제 값을 채운 뒤 이 파일을 .env로 복사해서 쓰세요 (.env는 .gitignore에 포함되어 커밋되지 않습니다).
#   cp .env.example .env

# MariaDB root 비밀번호 — api 서비스(SPRING_DATASOURCE_PASSWORD)와 db 서비스(MARIADB_ROOT_PASSWORD)가 공유해서 씁니다.
DB_PASSWORD=changeme

# 직원 로그인 JWT 서명 키 — 32바이트 이상 랜덤 값 권장. 운영 배포 시에는 반드시 아래 예시가 아닌 새로 생성한 값을 쓰세요.
JWT_SECRET=changeme-replace-with-a-long-random-base64-secret

# ---- 참고: 운영(prod) 배포 시 별도로 필요한 환경변수 ----
# (application-prod.properties.example 참고 — docker-compose에는 해당 없음)
# DB_URL=jdbc:mariadb://<host>:3306/sushiorder?useUnicode=true&characterEncoding=UTF-8
# DB_USERNAME=<db-username>
# DB_PASSWORD=<db-password>
# JWT_SECRET=<jwt-secret>
# JWT_EXPIRATION_MS=43200000
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
