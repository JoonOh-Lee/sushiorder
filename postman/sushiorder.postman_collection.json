          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"on\": false\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/staff/me/duty", "host": ["{{baseUrl}}"], "path": ["api", "v1", "staff", "me", "duty"] }
          }
        }
      ]
    },
