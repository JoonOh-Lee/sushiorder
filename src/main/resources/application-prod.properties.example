spring.application.name=sushiorder

# 운영은 리버스 프록시(nginx/ALB 등) 뒤에 떠 있다고 가정 — X-Forwarded-* 헤더를 신뢰해서
# ServletUriComponentsBuilder가 내부 주소(예: http://10.0.x.x:8080) 대신 외부에 노출된
# 실제 도메인/스킴으로 절대 URL(예: 메뉴 이미지 imageUrl)을 만들도록 한다.
server.forward-headers-strategy=framework

spring.datasource.url=${DB_URL}
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=org.mariadb.jdbc.Driver

# local과 달리 스키마를 앱이 재생성하지 않는다 — 마이그레이션 도구 도입 전까지는 운영 DB 스키마를 수동/별도 스크립트로 관리
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MariaDBDialect
spring.sql.init.mode=never

jwt.secret=${JWT_SECRET}
jwt.expiration-ms=${JWT_EXPIRATION_MS:43200000}

# 운영 프론트 도메인(들) — 콤마 구분. 로컬 기본값(localhost)이 운영에 새는 걸 막기 위해 fallback 없이 필수로 요구한다.
app.cors.allowed-origins=${CORS_ALLOWED_ORIGINS}
