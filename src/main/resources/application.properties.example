spring.application.name=sushiorder
spring.datasource.url=jdbc:mariadb://localhost:3306/sushiorder?useUnicode=true&characterEncoding=UTF-8
spring.datasource.username=root
spring.datasource.password=changeme
spring.datasource.driver-class-name=org.mariadb.jdbc.Driver
spring.jpa.hibernate.ddl-auto=create
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MariaDBDialect
spring.sql.init.mode=always
spring.sql.init.encoding=UTF-8
spring.jpa.defer-datasource-initialization=true
spring.datasource.hikari.maximum-pool-size=20

# Staff JWT - generate your own secret (32+ bytes), never commit the real value
jwt.secret=changeme-replace-with-a-long-random-base64-secret
jwt.expiration-ms=43200000

# QR 코드에 담길 프론트엔드 URL (테이블 QR 스캔 시 이동할 주소)
app.frontend-url=http://localhost:5173

# CORS 허용 출처 (콤마 구분, 공백 허용) — REST(SecurityConfig)와 WebSocket(WebSocketConfig) 둘 다 이 값을 쓴다.
# 생략하면 아래와 동일한 로컬 개발 서버 기본값이 적용된다.
app.cors.allowed-origins=http://localhost:3000,http://localhost:5173,http://172.31.99.96:5173
